# ============================================================================
# Sync Master CRM — Environment variables
# Copy to .env.local for development:  cp .env.example .env.local
# In production, set these in the Railway project Variables tab.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Project URL and public anon key (Project Settings → API).
# NEXT_PUBLIC_* vars are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key for trusted server-side code (bypasses RLS). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=

# --- Twilio (SMS) -----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Stripe (payments) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- NextAuth ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
