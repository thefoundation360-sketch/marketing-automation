# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Email delivery (https://resend.com)
RESEND_API_KEY=re_...
FROM_EMAIL=newsletters@yourdomain.com
OUTREACH_FROM_EMAIL=hello@outreach.yourdomain.com
OUTREACH_FROM_NAME=Your Name

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Business config
BUSINESS_NAME=NicheWire
OWNER_EMAIL=you@youremail.com
TARGET_NICHE=independent fitness studios
TARGET_CITY=Austin
TARGET_STATE=TX

# Newsletter config
NEWSLETTER_SUBJECT_PREFIX=[NicheWire]
MAX_OUTREACH_PER_DAY=20
PROSPECT_SCORE_THRESHOLD=60

# Optional: separate DB path (default: ./state.db)
# DATABASE_PATH=./state.db
