# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe (publishable key — safe to expose) ─────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe Price IDs (from your products dashboard)
VITE_STRIPE_PREMIUM_MONTHLY=price_...
VITE_STRIPE_PREMIUM_ANNUAL=price_...
VITE_STRIPE_ELITE_MONTHLY=price_...
VITE_STRIPE_ELITE_ANNUAL=price_...
VITE_STRIPE_BUSINESS_MONTHLY=price_...
VITE_STRIPE_BUSINESS_ANNUAL=price_...

# ── OneSignal Push Notifications ──────────────────────────────────────────────
# Get from: https://onesignal.com (free tier works)
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id
VITE_ONESIGNAL_SAFARI_ID=web.onesignal.auto.your-id

# ── App URL ───────────────────────────────────────────────────────────────────
VITE_APP_URL=https://your-app.vercel.app

# ── Supabase CLI (used by scripts/deploy.sh and GitHub Actions) ───────────────
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/general
SUPABASE_PROJECT_REF=abcdefghijklmnop
SUPABASE_DB_PASSWORD=your-database-password
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# ── Supabase Edge Function Secrets (set via: supabase secrets set KEY=value) ──
# These are NOT VITE_ prefixed — they run server-side only
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY is auto-available in Edge Functions

# ── Vercel (used by scripts/deploy.sh) ───────────────────────────────────────
# Get from: https://vercel.com/account/tokens
# VERCEL_TOKEN is only needed for CI — vercel login works interactively
# VERCEL_TOKEN=...
# VERCEL_ORG_ID=...      (from .vercel/project.json after first deploy)
# VERCEL_PROJECT_ID=...  (from .vercel/project.json after first deploy)
