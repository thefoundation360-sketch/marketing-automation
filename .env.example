# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe (publishable key — safe to expose) ─────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe Price IDs (from your products dashboard)
VITE_STRIPE_PREMIUM_MONTHLY=price_...
VITE_STRIPE_PREMIUM_ANNUAL=price_...
VITE_STRIPE_ELITE_MONTHLY=price_...
VITE_STRIPE_ELITE_ANNUAL=price_...
VITE_STRIPE_BUSINESS_MONTHLY=price_...
VITE_STRIPE_BUSINESS_ANNUAL=price_...

# ── OneSignal Push Notifications ──────────────────────────────────────────────
# Get from: https://onesignal.com (free tier works)
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id
VITE_ONESIGNAL_SAFARI_ID=web.onesignal.auto.your-id

# ── App URL ───────────────────────────────────────────────────────────────────
VITE_APP_URL=https://your-app.vercel.app

# ── Supabase Edge Function Secrets (set via: supabase secrets set KEY=value) ──
# These are NOT VITE_ prefixed — they run server-side only
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  (auto-available in Edge Functions)
